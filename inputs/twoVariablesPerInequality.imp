class twoVariablesPerInequalityTest {

    test_constant_assign() {
        def x = 5;
        def y = 3;
    }

    test_copy() {
        def x = 7;
        def y = x;
    }

    test_translation() {
        def x = 10;
        def y = x + 5;
    }

    test_transitivity() {
        def x = 10;
        def y = x + 2;
        def z = y + 1;
    }

    test_join() {
        def x = 0;
        def flag = 0;
        if (flag <= 0) {
            x = 0;
        } else {
            x = 10;
        }
    }

    test_join_preserves_relation() {
        def x = 0;
        def y = 0;
        def flag = 0;
        if (flag <= 0) {
            x = 2;
            y = x + 5;
        } else {
            x = 8;
            y = x + 5;
        }
    }

    test_loop_equality() {
        def i = 0;
        def j = 0;
        while (i <= 10) {
            i = i + 1;
            j = j + 1;
        }
    }

    test_loop_offset() {
        def i = 0;
        def j = 3;
        while (i <= 5) {
            i = i + 1;
            j = j + 1;
        }
    }

    test_widening() {
        def x = 0;
        while (0 <= x) {
            x = x + 1;
        }
    }

    test_projection() {
        def x = 0;
        def y = x + 4;
        def z = y + 2;
        y = 0;
    }

    test_satisfies() {
        def x = 3;
        def y = x + 2;
        if (x <= y) {
            x = x + 1;
        } else {
            x = 0;
        }
    }

    test_nontrivial_bounds() {
        def x = 2;
        def y = 0;
        if (x <= 4) {
            y = x + 1;
        }
    }

    test_long_chain() {
        def a = 0;
        def b = a + 1;
        def c = b + 1;
        def d = c + 1;
        def e = d + 1;
    }

}
