class intervalles {
	basic() {
		def i = 2;
		def j = -10;
		def a = i + j;
		def s = i - j;
		def m = i * j;
		def d = i / j;
	}

	branches(a) {
	    def x = 10;
	    def y = 20;
	    if(a > 0)
	        x = -10;
	    else y = 0;
	    def z = x + y;
	    def k = x / y;
	}


	complex_branches(a) {
	    def x = 10;
	    def y = 20;
	    def z = 30;
	    if(a > 0) {
	        x = -10;
	        y = 10;
	        z = 25;
	    }
	    else {
	        y = 0;
	        x = 0;
	        z = 0;
	    }
	    def q = x + y;
	    def k = q - y;
	    q = x * y;
	    k = q + y;
	    q = q * k;
	    k = q + y;
	}


}